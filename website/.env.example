# Environment variables — Cambodian Food Stars website

# Optional: Resend email delivery for contact + reservation forms.
# Without these, submissions are validated and logged server-side,
# and the UI asks guests to also call the restaurant.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Optional: override public site URL used in metadata / sitemap
# NEXT_PUBLIC_SITE_URL=https://cambodian-food-stars.higgsfield.app
